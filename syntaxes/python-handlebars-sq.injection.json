      "end": "\\}\\}|(?=''')"
    },
    "block-close-plain": {
      "name": "meta.function.block.end.handlebars meta.handlebars.pymdbars",
      "begin": "(\\{\\{~?/)\\s*([\\w./@-]+)",
      "beginCaptures": {
        "1": {
          "name": "support.constant.handlebars"
        },
        "2": {
          "patterns": [
            {
              "match": "\\b(?:if|unless|each|with)(?![\\w./@-])",
