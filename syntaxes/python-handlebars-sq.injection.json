    "fstring-interpolation": {
      "name": "meta.interpolation.pymdbars",
      "begin": "\\{(?!\\{)",
      "beginCaptures": {
        "0": {
          "name": "constant.character.format.placeholder.other.python"
        }
      },
      "end": "(\\})|(?=''')",
      "endCaptures": {
        "1": {
          "name": "constant.character.format.placeholder.other.python"
        }
      },
      "patterns": [
        {
          "include": "source.python#fstring-terminator-multi"
        },
        {
          "include": "source.python#f-expression"
        }
      ]
    },
    "args-plain": {
      "patterns": [
        {
          "name": "meta.subexpression.handlebars",
          "begin": "\\(",
          "end": "\\)|(?=~?\\}\\})|(?=''')",
          "patterns": [
            {
              "include": "#args-plain"
            }
          ]
        },
        {
          "match": "\\b(as)\\s+(\\|)((?:(?!''')[^|\\n])*)(\\|)",
          "captures": {
            "1": {
              "name": "keyword.control.handlebars"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.handlebars"
            },
            "3": {
              "name": "variable.parameter.handlebars"
            },
            "4": {
              "name": "punctuation.definition.parameters.end.handlebars"
            }
          }
        },
        {
          "match": "([\\w-]+)(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.handlebars"
            },
            "2": {
              "name": "keyword.operator.assignment.handlebars"
            }
          }
        },
        {
          "name": "string.quoted.double.handlebars",
          "begin": "\"(?=(?:(?!''')[^\"\\n])*(?!''')\")",
          "end": "\""
        },
        {
          "name": "string.quoted.single.handlebars",
          "begin": "'(?=(?:(?!''')[^'\\n])*(?!''')')",
          "end": "'"
        },
        {
          "name": "string.quoted.double.handlebars",
          "begin": "\"",
          "end": "(?=''')|(?=~?\\}\\})|\"|$"
        },
        {
          "name": "string.quoted.single.handlebars",
          "begin": "'",
          "end": "(?=''')|(?=~?\\}\\})|'|$"
        },
        {
          "name": "constant.numeric.handlebars",
          "match": "(?<![\\w.@/-])-?\\d+(?:\\.\\d+)?(?![\\w.@/-])"
        },
        {
          "name": "constant.language.handlebars",
          "match": "(?<![\\w.@/-])(?:true|false|null|undefined)(?![\\w.@/-])"
        },
        {
          "name": "variable.parameter.handlebars",
          "match": "[\\w./@-]+"
        }
      ]
    },
    "comment-block-plain": {
      "name": "comment.block.handlebars meta.handlebars.pymdbars",
      "begin": "\\{\\{~?!--",
      "end": "--~?\\}\\}|(?=''')"
    },
    "comment-plain": {
      "name": "comment.block.handlebars meta.handlebars.pymdbars",
