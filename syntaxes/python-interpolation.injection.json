{
  "scopeName": "markdown-template.python.interpolation.dq",
  "injectionSelector": "L:meta.template.pymdbars.fstring meta.template.quotes.dq -meta.interpolation.pymdbars -meta.handlebars.pymdbars",
  "patterns": [
    {
      "include": "markdown-template.python.handlebars.dq#fstring-tags"
    },
    {
      "include": "#escaped-brace"
    },
    {
      "include": "markdown-template.python.handlebars.dq#fstring-interpolation"
    }
  ],
  "repository": {
    "escaped-brace": {
      "name": "constant.character.escape.python",
      "match": "\\{\\{|\\}\\}"
    }
  }
}
