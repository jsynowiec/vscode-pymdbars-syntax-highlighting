root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,ts,json,yaml,yml,toml}]
indent_size = 2
indent_style = space

[*.py]
indent_size = 4
indent_style = space

[Makefile]
indent_style = tab

[*.md]
insert_final_newline = false
trim_trailing_whitespace = false
