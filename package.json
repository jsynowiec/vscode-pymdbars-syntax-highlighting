{
  "name": "vscode-pymdbars-syntax-highlighting",
  "displayName": "PyMDBars - Markdown Handlebars highlighting in Python",
  "description": "Syntax highlighting for Markdown, Python expressions, and Handlebars prompt templates in Python code.",
  "version": "0.1.0",
  "publisher": "jsynowiec",
  "homepage": "https://github.com/jsynowiec/vscode-pymdbars-syntax-highlighting#readme",
  "bugs": {
    "url": "https://github.com/jsynowiec/vscode-pymdbars-syntax-highlighting/issues"
  },
  "license": "MIT",
  "author": "Jakub Synowiec",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsynowiec/vscode-pymdbars-syntax-highlighting"
  },
  "scripts": {
    "vscode:prepublish": "pnpm run check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "generate": "tsx scripts/generate-grammars.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint __tests__ scripts",
    "lint:fix": "oxlint --fix __tests__ scripts",
    "format:check": "oxfmt --check '{__tests__,scripts,syntaxes}/**/*.{ts,json}'",
    "format": "oxfmt '{__tests__,scripts,syntaxes}/**/*.{ts,json}'",
    "test": "tsx --test __tests__/*.test.ts",
    "package": "pnpm vsce package --no-dependencies",
    "publish": "pnpm vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vscode/vsce": "^4.1.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">= 22"
  },
  "files": [
    "LICENSE",
    "syntaxes/*.json",
    "images/icon.png"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "markdown",
    "handlebars",
    "syntax highlighting",
    "prompt templates",
    "pydantic",
    "pydantic ai",
    "templatestr",
    "f-string"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "markdown-template.python.entry",
        "path": "./syntaxes/python-entry.injection.json",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "scopeName": "markdown-template.python.handlebars",
        "path": "./syntaxes/python-handlebars.injection.json",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "scopeName": "markdown-template.python.interpolation",
        "path": "./syntaxes/python-interpolation.injection.json",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "scopeName": "markdown-template.python.spans",
        "path": "./syntaxes/python-spans.injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ]
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#005696",
    "theme": "dark"
  }
}
